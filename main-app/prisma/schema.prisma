generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT_GUARDIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum AttendanceVerificationMethod {
  FINGERPRINT
  MANUAL
}

enum FingerLabel {
  LEFT_THUMB
  LEFT_INDEX
  LEFT_MIDDLE
  LEFT_RING
  LEFT_LITTLE
  RIGHT_THUMB
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_LITTLE
}

enum FingerprintTemplateStatus {
  ACTIVE
  REVOKED
  REPLACED
}

enum BiometricDeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum BiometricScanPurpose {
  ENROLLMENT
  ATTENDANCE_VERIFICATION
  IDENTIFICATION
}

enum BiometricScanStatus {
  SUCCESS
  FAILED
  LOW_QUALITY
  NO_MATCH
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationType {
  ABSENCE_ALERT
  LATENESS_ALERT
  WEEKLY_SUMMARY
  TERMLY_SUMMARY
  SCHOOL_ANNOUNCEMENT
  ACCOUNT_UPDATE
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
  TERMLY
  CUSTOM
}

enum ExportFormat {
  PDF
  CSV
  EXCEL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ENROLL_FINGERPRINT
  VERIFY_ATTENDANCE
  GENERATE_REPORT
  EXPORT_REPORT
}

model School {
  id      String       @id @default(cuid())
  name    String
  code    String       @unique
  email   String?
  phone   String?
  address String?
  city    String?
  region  String?
  country String       @default("Ghana")
  status  SchoolStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                         User[]
  teachers                      Teacher[]
  guardians                     ParentGuardian[]
  students                      Student[]
  classes                       Class[]
  academicYears                 AcademicYear[]
  academicTerms                 AcademicTerm[]
  biometricDevices              BiometricDevice[]
  fingerprintRecords            FingerprintTemplate[]
  attendanceSessions            AttendanceSession[]
  attendanceRecords             AttendanceRecord[]
  reports                       Report[]
  notifications                 Notification[]
  settings                      SchoolSetting[]
  auditLogs                     AuditLog[]
  biometricScanLogs             BiometricScanLog[]
  parentNotificationPreferences ParentNotificationPreference[]

  @@index([name])
  @@index([status])
}

model AcademicYear {
  id       String   @id @default(cuid())
  schoolId String
  name     String
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms              AcademicTerm[]
  classes            Class[]
  attendanceSessions AttendanceSession[]
  reports            Report[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
  @@index([schoolId, isActive])
}

model AcademicTerm {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  reports            Report[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([isActive])
  @@index([schoolId, isActive])
}

model SchoolSetting {
  id       String @id @default(cuid())
  schoolId String
  key      String
  value    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId])
}

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  schoolId String?
  role     UserRole   @default(TEACHER)
  status   UserStatus @default(ACTIVE)

  firstName   String?
  lastName    String?
  phone       String?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  accounts Account[]
  sessions Session[]

  teacherProfile  Teacher?
  guardianProfile ParentGuardian?

  enrolledFingerprints          FingerprintTemplate[]         @relation("EnrolledFingerprints")
  createdAttendanceSessions     AttendanceSession[]           @relation("CreatedAttendanceSessions")
  markedAttendanceRecords       AttendanceRecord[]            @relation("MarkedAttendanceRecords")
  generatedReports              Report[]
  biometricScanLogs             BiometricScanLog[]
  auditLogs                     AuditLog[]
  notifications                 Notification[]
  parentNotificationPreferences ParentNotificationPreference?

  @@index([schoolId])
  @@index([role])
  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Teacher {
  id          String  @id @default(cuid())
  userId      String  @unique
  schoolId    String
  staffNumber String?
  department  String?
  title       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classAssignments   ClassTeacher[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
}

model ParentGuardian {
  id           String  @id @default(cuid())
  userId       String  @unique
  schoolId     String?
  occupation   String?
  address      String?
  relationship String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  students                StudentGuardian[]
  notificationPreferences ParentNotificationPreference?

  @@index([schoolId])
}

model Student {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String?
  studentNumber String
  firstName     String
  lastName      String
  otherName     String?
  gender        Gender
  dateOfBirth   DateTime?
  photoUrl      String?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  fingerprints      FingerprintTemplate[]
  attendanceRecords AttendanceRecord[]
  guardians         StudentGuardian[]
  biometricScanLogs BiometricScanLog[]
  reports           Report[]
  notifications     Notification[]

  @@unique([schoolId, studentNumber])
  @@index([schoolId])
  @@index([classId])
  @@index([isActive])
  @@index([lastName, firstName])
  @@index([schoolId, classId, isActive])
  @@index([schoolId, lastName, firstName])
}

model StudentGuardian {
  id           String  @id @default(cuid())
  studentId    String
  guardianId   String
  relationship String
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian ParentGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
}

model Class {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String?
  name           String
  code           String?
  level          String?
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  students           Student[]
  teacherAssignments ClassTeacher[]
  attendanceSessions AttendanceSession[]
  reports            Report[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([academicYearId])
}

model ClassTeacher {
  id        String  @id @default(cuid())
  classId   String
  teacherId String
  isLead    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
}

model BiometricDevice {
  id           String                @id @default(cuid())
  schoolId     String
  name         String
  model        String                @default("ZKTeco ZK9500")
  serialNumber String?
  bridgeUrl    String?
  sdkName      String?               @default("ZKFinger SDK")
  status       BiometricDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fingerprintTemplates FingerprintTemplate[]
  scanLogs             BiometricScanLog[]
  attendanceRecords    AttendanceRecord[]

  @@unique([schoolId, serialNumber])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, bridgeUrl])
}

model FingerprintTemplate {
  id           String                    @id @default(cuid())
  schoolId     String
  studentId    String
  deviceId     String?
  finger       FingerLabel
  templateHash String?
  templateData Bytes?
  sdkFormat    String?
  qualityScore Int?
  status       FingerprintTemplateStatus @default(ACTIVE)

  enrolledByUserId String?
  enrolledAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device     BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  enrolledBy User?            @relation("EnrolledFingerprints", fields: [enrolledByUserId], references: [id], onDelete: SetNull)

  scanLogs          BiometricScanLog[]
  attendanceRecords AttendanceRecord[]

  @@unique([studentId, finger, status])
  @@index([schoolId])
  @@index([studentId])
  @@index([deviceId])
  @@index([status])
  @@index([schoolId, status])
}

model BiometricScanLog {
  id                 String               @id @default(cuid())
  schoolId           String
  studentId          String?
  deviceId           String?
  templateId         String?
  performedById      String?
  attendanceRecordId String?
  clientRequestId    String?              @unique
  purpose            BiometricScanPurpose
  status             BiometricScanStatus
  matchScore         Int?
  message            String?
  scannedAt          DateTime             @default(now())

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  device           BiometricDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  template         FingerprintTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  performedBy      User?                @relation(fields: [performedById], references: [id], onDelete: SetNull)
  attendanceRecord AttendanceRecord?    @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId])
  @@index([deviceId])
  @@index([purpose])
  @@index([status])
  @@index([scannedAt])
  @@index([schoolId, scannedAt])
}

model AttendanceSession {
  id              String                  @id @default(cuid())
  schoolId        String
  classId         String?
  teacherId       String?
  academicYearId  String?
  academicTermId  String?
  title           String
  sessionDate     DateTime
  startsAt        DateTime?
  endsAt          DateTime?
  status          AttendanceSessionStatus @default(SCHEDULED)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher      Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CreatedAttendanceSessions", fields: [createdByUserId], references: [id], onDelete: SetNull)

  records AttendanceRecord[]

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@index([sessionDate])
  @@index([status])
  @@index([schoolId, sessionDate, createdAt])
  @@index([schoolId, status])
  @@index([classId, sessionDate])
  @@index([teacherId, sessionDate])
}

model AttendanceRecord {
  id                 String                       @id @default(cuid())
  schoolId           String
  sessionId          String
  studentId          String
  deviceId           String?
  templateId         String?
  clientRequestId    String?                      @unique
  status             AttendanceStatus
  markedAt           DateTime                     @default(now())
  markedByUserId     String?
  verificationMethod AttendanceVerificationMethod @default(FINGERPRINT)
  fingerprintMatched Boolean                      @default(false)
  fingerprintScore   Int?
  remarks            String?
  capturedOffline    Boolean                      @default(false)
  syncedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session  AttendanceSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device   BiometricDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  template FingerprintTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  markedBy User?                @relation("MarkedAttendanceRecords", fields: [markedByUserId], references: [id], onDelete: SetNull)

  biometricScanLogs BiometricScanLog[]
  notifications     Notification[]

  @@unique([sessionId, studentId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@index([markedAt])
  @@index([verificationMethod])
  @@index([schoolId, markedAt])
  @@index([schoolId, status, markedAt])
  @@index([sessionId, markedAt])
  @@index([studentId, markedAt])
}

model Report {
  id             String        @id @default(cuid())
  schoolId       String
  classId        String?
  studentId      String?
  academicYearId String?
  academicTermId String?
  generatedById  String?
  type           ReportType
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  fileUrl        String?
  exportFormat   ExportFormat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)
  generatedBy  User?         @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([classId])
  @@index([studentId])
  @@index([type])
  @@index([startDate, endDate])
}

model Notification {
  id                 String              @id @default(cuid())
  userId             String?
  schoolId           String?
  studentId          String?
  attendanceRecordId String?
  channel            NotificationChannel
  status             NotificationStatus  @default(PENDING)
  type               NotificationType    @default(ACCOUNT_UPDATE)
  title              String
  message            String
  readAt             DateTime?
  sentAt             DateTime?
  failedAt           DateTime?
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  school           School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([studentId])
  @@index([attendanceRecordId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([readAt])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([schoolId, createdAt])
  @@index([schoolId, readAt])
}

model ParentNotificationPreference {
  id         String  @id @default(cuid())
  userId     String  @unique
  guardianId String  @unique
  schoolId   String?

  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  inAppEnabled    Boolean @default(true)

  absentAlerts  Boolean @default(true)
  lateAlerts    Boolean @default(true)
  weeklySummary Boolean @default(true)
  termlySummary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian ParentGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  school   School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model AuditLog {
  id          String      @id @default(cuid())
  schoolId    String?
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([schoolId, createdAt])
}
